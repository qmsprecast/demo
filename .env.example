GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173
# Customer-facing support inbox for server-generated notifications (incidents, etc.). Optional alias: APP_ADMIN_EMAIL.
APP_SUPPORT_EMAIL=admin@usebert.co.uk
# Full product line for emails, invites, and OAuth pages (short name — tagline).
APP_BRAND_NAME=BERT — Business. Evaluate. Report. Tool.
# Short name shown in the app shell; client tagline is "Business. Evaluate. Report. Tool." (bert.).
VITE_APP_NAME=BERT
GOOGLE_SHARED_DRIVE_ID=your-google-root-folder-id
GOOGLE_ONBOARDING_FORM_ID=your-master-onboarding-form-id
GOOGLE_ONBOARDING_SHEET_ID=your-master-onboarding-response-sheet-id
# Throttle back-to-back Sheets reads (values.get / spreadsheets.get). Default 500; raise (e.g. 800–1200) if you hit per-minute read quota in dev.
SHEETS_READ_GAP_MS=500
# Optional: extra quota retries (default 8). Lower only for faster failure in tests.
# SHEETS_QUOTA_MAX_RETRIES=8
SESSION_SECRET=replace-this-with-a-long-random-secret
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=BERT
VITE_GODMODE_USERNAME=master
VITE_GODMODE_PASSWORD=demo
VITE_ENABLE_DEMO_ROLE_SWITCH=true
