{
  "name": "qms-precast-preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm run server\" \"wait-on tcp:127.0.0.1:8787 && npm run dev\"",
    "server": "node server/server.mjs",
    "google:connect": "node scripts/print-google-connect-urls.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "nodemailer": "^8.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "wait-on": "^8.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
